# LifeCalc Production Environment Configuration
# Copy this file to .env.local for local production emulation

# REQUIRED in production: Must be at least 32 characters long
SESSION_SECRET=change_this_to_a_secure_random_64_character_hex_session_secret_2026
GUEST_QUOTA_SECRET=change_this_to_a_secure_random_64_character_hex_guest_secret_2026

# DATABASE PERSISTENCE SELECTION:
# In production, set DATABASE_MODE=supabase. In local development or offline test, set DATABASE_MODE=local.
DATABASE_MODE=supabase

# REQUIRED when DATABASE_MODE=supabase:
# Authoritative persistent datastore connection parameters.
# NOTE: The SUPABASE_SERVICE_ROLE_KEY is used strictly server-side and must never be exposed to client bundles.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key